{
  "name": "@touchline/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/server.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/server.mjs"
  },
  "dependencies": {
    "@touchline/shared": "0.1.0",
    "@touchline/data": "0.1.0",
    "@touchline/engine": "0.1.0",
    "@touchline/host": "0.1.0",
    "socket.io": "4.8.1"
  },
  "devDependencies": {
    "socket.io-client": "4.8.1"
  }
}
