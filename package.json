{
  "name": "touchline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Two-phone, tactics-only football knockout final.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @touchline/web",
    "dev:server": "npm run dev -w @touchline/server",
    "build": "npm run build -w @touchline/web",
    "build:server": "npm run build -w @touchline/server",
    "start": "npm run start -w @touchline/server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:balance": "vitest run --config vitest.balance.config.ts",
    "test:e2e": "node tools/e2e.mjs",
    "data:check": "tsx tools/check-data.ts",
    "squads:expand": "tsx tools/expand-squad.ts",
    "calibrate": "tsx tools/calibrate.ts",
    "replay": "tsx tools/replay.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.15.0",
    "esbuild": "0.25.12",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.40.0",
    "vitest": "~3.2.7"
  }
}
